# secrets.nix — Machine-specific configuration (NOT tracked in git)
#
# Copy this file to /etc/nixos/secrets.nix and fill in your values.
# The actual secrets.nix is in .gitignore.
#
# To generate password hashes:
#   nix-shell -p caddy --run "caddy hash-password --plaintext 'YOUR_PASSWORD'"

{
  # Domain name (must have DNS A record pointing to this instance's Elastic IP)
  domain = "storage.yourdomain.com";

  # S3 bucket name (created by the CloudFormation stack)
  s3Bucket = "retroarch-saves-123456789012";

  # AWS region where the bucket lives
  s3Region = "us-east-1";

  # RetroArch user — restricted to /retroarch/* only.
  # Use a weaker/disposable password here since RetroArch stores it in plain text.
  retroarchUser = "retroarch";
  retroarchPasswordHash = "$2a$14$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX";

  # Admin user — full access to all paths (/retroarch/*, /backups/*, /media/*).
  # Use a strong password here. Only used by clients you trust (rclone, Dolphin, curl).
  adminUser = "myuser";
  adminPasswordHash = "$2a$14$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX";

  # SSH public keys for the admin user (one string per key)
  sshPublicKeys = [
    "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... your-key-comment"
  ];
}
